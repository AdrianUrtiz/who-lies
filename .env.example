# Template de variables de entorno (raíz, para Docker Compose).
# Copia a .env.development o .env.production y ajusta valores.
# NUNCA commitees .env.production con secretos reales.

# PostgreSQL (creación del contenedor)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=who_lies
POSTGRES_PORT=5432

# Backend DENTRO de la red Docker (host = nombre del servicio "postgres").
# Debe coincidir con POSTGRES_* de arriba.
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/who_lies?schema=public

# Backend
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Frontend (URL pública del backend vista desde el NAVEGADOR, no desde Docker).
# Se embebe en el build de producción: cada entorno necesita su propio build.
VITE_SOCKET_URL=http://localhost:3001
