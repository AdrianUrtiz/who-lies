# PLANTILLA para el servidor propio. NO commitear el archivo real.
# En el servidor: cp .env.production.example .env.production && editar secretos.
# Uso: docker compose --env-file .env.production -f compose.yml -f compose.prod.yml up -d --build

POSTGRES_USER=who_lies
POSTGRES_PASSWORD=CHANGE_ME_GENERA_UN_PASSWORD_LARGO
POSTGRES_DB=who_lies
POSTGRES_PORT=5432

DATABASE_URL=postgresql://who_lies:CHANGE_ME_GENERA_UN_PASSWORD_LARGO@postgres:5432/who_lies?schema=public

PORT=3001
# Origen público del frontend (dominio o IP del servidor)
CORS_ORIGIN=https://tu-servidor.example.com

# URL del backend vista desde el NAVEGADOR (dominio/IP + puerto expuesto o reverse proxy)
VITE_SOCKET_URL=https://tu-servidor.example.com:3001
