# Backend nativo (npm fuera de Docker): copia a `.env` y ajusta.
# host localhost = Postgres publicado por compose en tu máquina.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/who_lies?schema=public"
PORT=3001
# Allowlist CORS separada por comas (dev: solo frontend local).
CORS_ORIGIN=http://localhost:5173

# P2-T1: Redis para multi-instancia (Socket.IO adapter + locks + fan-out).
# Sin REDIS_URL el backend arranca en modo single-node (presencia en memoria).
# REDIS_URL=redis://localhost:6379

# P1-B2: gracia de reconexión en ms (default 60000).
# PRESENCE_GRACE_MS=60000

# P2-T2: rate limiting WS por minuto y ámbito (defaults holgados para suites).
# RATE_LIMIT_CREATE_PER_MIN=60
# RATE_LIMIT_JOIN_PER_MIN=120
# RATE_LIMIT_VOTE_PER_MIN=120
# RATE_LIMIT_DEFAULT_PER_MIN=120
