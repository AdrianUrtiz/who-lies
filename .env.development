# Desarrollo local con Docker (valores seguros, commiteado a propósito).
# Uso: docker compose --env-file .env.development up --build

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=who_lies
POSTGRES_PORT=5432

# Host "postgres" = servicio Docker. Para backend NATIVO (npm fuera de Docker)
# usa en su lugar backend/.env con @localhost (ver backend/.env.example).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/who_lies?schema=public

PORT=3001
CORS_ORIGIN=http://localhost:5173
VITE_SOCKET_URL=http://localhost:3001
